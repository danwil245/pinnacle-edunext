# Backend configuration. Copy to backend/.env for local dev. All values are read
# and validated at boot (see backend/src/config.js).

# Node environment: development | test | production
NODE_ENV=development

# Port the Express API listens on (Render injects PORT automatically).
PORT=4000

# Comma-separated list of allowed frontend origins (exact, no trailing slash).
# Example in production: https://edunext.vercel.app,http://localhost:4173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional: comma-separated regex sources to also allow (e.g. Vercel preview URLs).
# Off by default. Example: ^https://edunext-[a-z0-9-]+\.vercel\.app$
# CORS_ORIGIN_PATTERNS=

# JWT signing secret. In production this MUST be a strong value (>= 32 chars,
# not a known default) or the server refuses to start. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret-change-me

# SQLite database file path. On Render free tier this is ephemeral (resets on
# restart); mount a persistent disk and set e.g. /var/data/edunext.db to keep data.
DATABASE_PATH=./data/edunext.db

# Log verbosity: debug | info | warn | error | silent
LOG_LEVEL=info
