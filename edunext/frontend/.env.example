# Frontend environment. Copy to frontend/.env.local for local overrides.
#
# Base URL of the EduNext backend (no trailing slash). In production (Vercel)
# this MUST be set to your Render backend URL, e.g. https://edunext-api.onrender.com
# In local dev you can leave it unset to use the Vite proxy, or point it at the
# backend for a two-origin test:
VITE_API_URL=http://localhost:4000

# Build the app in mock-signal mode (no webcam needed). Optional; dev/demo only.
# VITE_MOCK_SIGNALS=1
